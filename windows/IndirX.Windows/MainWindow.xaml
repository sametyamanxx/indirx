<Window x:Class="IndirX.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="İndirX — YouTube ve Instagram" Icon="Assets/IndirX.ico" Width="1120" Height="900" MinWidth="840" MinHeight="640" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <ScrollViewer x:Name="PageScroller" Margin="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="MainLayout" Height="{Binding ViewportHeight, ElementName=PageScroller}" MinHeight="650" LayoutUpdated="MainLayout_LayoutUpdated">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel x:Name="HeaderPanel" Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="0,0,0,24">
        <Image x:Name="BrandLogo" Source="Assets/Logo.png" Width="72" Height="72" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Android ile aynı İndirX logosu" />
        <TextBlock x:Name="BrandTitle" Text="İNDİRX" TextAlignment="Center" FontSize="32" FontWeight="Bold" Margin="0,8,0,6" />
        <TextBlock x:Name="PlatformLabel" Text="YouTube · Instagram" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="14" />
      </StackPanel>
      <Grid x:Name="LeftColumn" Grid.Row="1" Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel x:Name="ControlsPanel">
          <Border x:Name="LinkCard" Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Bağlantı ekle" Style="{StaticResource Heading}" />
            <TextBlock Text="Yalnızca YouTube ve Instagram bağlantıları" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
            <TextBox x:Name="LinkBox" MinHeight="66" TextWrapping="Wrap" VerticalContentAlignment="Center" TextChanged="LinkBox_TextChanged" AutomationProperties.Name="Video veya çalma listesi bağlantısı" />
            <WrapPanel Margin="0,16,0,0"><Button Content="Panodan yapıştır" Click="Paste_Click" /><Button x:Name="ContentActionButton" Content="İçerikleri bul" Background="#7B9CF5" Foreground="#0E182B" Click="ContentAction_Click" IsEnabled="False" /></WrapPanel>
          </StackPanel></Border>
        </StackPanel>
          <Border x:Name="DownloadsCard" Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="DownloadsContentRow" Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="DownloadsHeading" Text="İndirmeler" Style="{StaticResource Heading}" />
            <Grid x:Name="DownloadsViewport" Grid.Row="1">
              <Grid.RowDefinitions><RowDefinition x:Name="MediaRow" Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid x:Name="MediaRegion" Grid.Row="0">
                <TextBlock x:Name="EmptyContentHint" Text="Bulunan videolar burada gösterilecek." Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <DockPanel x:Name="ResultsPanel" Visibility="Collapsed">
                  <StackPanel x:Name="PlaylistHeader" DockPanel.Dock="Top" Visibility="Collapsed">
                    <TextBlock x:Name="CollectionTitle" FontSize="15" FontWeight="SemiBold" MaxHeight="40" Margin="0,0,0,8" />
                    <DockPanel Margin="0,0,0,8">
                      <Button x:Name="SelectAllButton" Content="Tümünü Seç" Click="SelectAll_Click" DockPanel.Dock="Right" MinHeight="32" Padding="10,4" Margin="8,0,0,0" />
                      <TextBlock x:Name="SelectionText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                  <ListBox x:Name="ResultsList" Style="{StaticResource DownloadListStyle}" BorderThickness="0" Background="#182131" Foreground="#E2E8F4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel" PreviewMouseWheel="ResultsList_PreviewMouseWheel">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Border Background="#0F1520" CornerRadius="8" Padding="12" Margin="0,0,0,8"><DockPanel><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Visibility="{Binding SelectionVisibility}" Margin="0,0,12,0" AutomationProperties.Name="İçeriği seç" /><StackPanel><TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Item.Duration}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Grid>
              <StackPanel x:Name="OperationPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock x:Name="StatusText" FontSize="15" />
                <TextBlock x:Name="DetailText" Foreground="{StaticResource Muted}" FontSize="12" MaxHeight="32" Margin="0,4,0,8" />
                <DockPanel>
                  <Button x:Name="CancelButton" Content="İptal" DockPanel.Dock="Right" Click="Cancel_Click" IsEnabled="False" MinHeight="32" Padding="10,4" Margin="12,0,0,0" />
                  <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100" Foreground="#7B9CF5" Background="#2D394E" BorderThickness="0" VerticalAlignment="Center" />
                </DockPanel>
              </StackPanel>
            </Grid>
            <ScrollViewer x:Name="HistoryPanel" Grid.Row="2" MaxHeight="96" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
              <TextBlock x:Name="HistoryText" FontSize="12" />
            </ScrollViewer>
          </Grid></Border>
      </Grid>
      <StackPanel x:Name="RightColumn" Grid.Row="1" Grid.Column="2" VerticalAlignment="Top">
          <Border x:Name="PreferencesCard" Style="{StaticResource Card}"><StackPanel x:Name="PreferencesPanel">
            <TextBlock Text="İndirme tercihleri" Style="{StaticResource Heading}" />
            <WrapPanel><RadioButton x:Name="VideoMode" GroupName="Mode" Content="Video" IsChecked="True" Checked="Mode_Changed" /><RadioButton x:Name="AudioMode" GroupName="Mode" Content="Ses" Checked="Mode_Changed" /></WrapPanel>
            <ComboBox x:Name="FormatBox" DisplayMemberPath="Name" SelectionChanged="Format_Changed" AutomationProperties.Name="Dosya biçimi" />
            <TextBlock Text="Seçtiğin biçimde mevcut en yüksek kaynak kalitesi. Dönüştürme kaynak kalitesini artırmaz." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,16" />
            <TextBlock x:Name="FolderText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
            <Button Content="Kayıt klasörünü seç" Click="ChooseFolder_Click" />
          </StackPanel></Border>
      <Border x:Name="UpdateCard" Style="{StaticResource Card}">
        <Button x:Name="UpdateButton" Content="İndirme altyapısını güncelle" Click="Update_Click" Margin="0" />
      </Border>
      </StackPanel>
      <TextBlock x:Name="VersionText" Grid.Row="2" Grid.ColumnSpan="3" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
    </Grid>
  </ScrollViewer>
</Window>
